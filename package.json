{
  "name": "claim-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first claim-to-receipt review desk. Open-weight embeddings in a Web Worker; the human sets every verdict.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.ts",
    "assets": "bash scripts/fetch-assets.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0"
  }
}
